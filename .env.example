# Required
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=yourbotname

# Runtime role: web | worker | both
ROLE=both
# For webhook mode, set WEBHOOK_URL (https://your.host/webhook). Empty = long polling.
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080

# Database (asyncpg)
DATABASE_URL=postgresql+asyncpg://memebot:memebot@postgres:5432/memebot
REDIS_URL=redis://redis:6379/0

# Admins (comma-separated Telegram user ids) — manual removal, full command set
ADMIN_USERS=

# Public pool / voting (spec §5.2)
VOTE_WINDOW_HOURS=48
APPROVE_NET_SCORE=10
APPROVE_MIN_UPVOTES=5
REJECT_NET_SCORE=-5
NSFW_APPROVE_NET_SCORE=20
RESUBMIT_COOLDOWN_DAYS=30

# Removal policy (spec §5.5)
REPORT_THRESHOLD=5
REPORT_WINDOW_HOURS=72
REVIEW_VOTE_WINDOW_HOURS=24
APPEAL_WINDOW_DAYS=7

# Trust / weighting (spec §5.4)
NEW_ACCOUNT_AGE_DAYS=1
NEW_ACCOUNT_WEIGHT=0.5
ESTABLISHED_WEIGHT=1.0
PENALIZED_WEIGHT=0.25
ESTABLISHED_AGE_DAYS=30

# Private pool
DEFAULT_PRIVATE_QUOTA=200

# Search ranking weights (spec §6.1)
RANK_TEXT_WEIGHT=1.0
RANK_POPULARITY_WEIGHT=0.3
RANK_RECENCY_WEIGHT=0.2
RANK_REPORT_PENALTY=0.5

# Review channel (a Telegram channel/group id, negative for channels)
REVIEW_CHANNEL_ID=

# Rate limits (spec §7.6)
INLINE_RATE_PER_MIN=20
SUGGEST_RATE_PER_HOUR=10
REPORT_RATE_PER_HOUR=20

# Object storage fallback (spec §6.2) — leave S3_* empty to use local filesystem
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Local durable store path when S3 is not configured (dev/test)
STORAGE_PATH=./storage

# Illegal-content blocklist (spec §5.3) — comma-separated sha256 hashes
ILLEGAL_HASHES=

# Community downvote removal (spec §5.5.4)
COMMUNITY_DOWNVOTE_THRESHOLD=20

# Metrics (spec §7.5)
METRICS_PORT=9090

LOG_LEVEL=INFO
INLINE_CACHE_SECONDS=300
